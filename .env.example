# Copy this file to .env and fill in real values LOCALLY.
# Never paste real credentials into a chat with Claude or anyone else.

# --- Uniware ---
UNIWARE_BASE_URL=https://<your-tenant>.unicommerce.com
UNIWARE_ACCESS_TOKEN=
UNIWARE_MAIN_FACILITY_CODE=

# Dummy facility codes per channel (get these from Uniware admin or
# the Search Facility API: https://documentation.unicommerce.com/docs/facility-search.html)
FACILITY_AMAZON_DUMMY=
FACILITY_FLIPKART_DUMMY=
FACILITY_MYNTRA_DUMMY=
FACILITY_DISTRIBUTOR_DUMMY=
FACILITY_BLINKIT_DUMMY=
FACILITY_ZEPTO_DUMMY=
FACILITY_SWIGGY_DUMMY=
FACILITY_D2C_DUMMY=

# --- BigQuery ---
BQ_PROJECT=zouk-wh
BQ_DATASET=MapleMonk
BQ_TABLE=zouk_facility_switch_log
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
