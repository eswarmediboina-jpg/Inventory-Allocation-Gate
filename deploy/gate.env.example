# Copy to gate.env on the server (next to app.py) and fill in.
# Referenced by the systemd unit's EnvironmentFile. Keep it private:
#   chmod 600 gate.env    (and it is gitignored — never commit it)

# REQUIRED in production: a long, fixed, random secret shared across workers.
# Generate once with:  python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Set to true — the app is served over HTTPS via Caddy, so the session
# cookie must be HTTPS-only.
SESSION_COOKIE_SECURE=true

# BigQuery logging auth: path to a GCP service-account key file on the VM.
# (Or run `gcloud auth application-default login` instead and omit this.)
GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/uniware_gate/sa.json
