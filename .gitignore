# --- Secrets / environment ---
# Never commit real credentials. The .env.example placeholder IS committed.
.env
.env.*
!.env.example
# Server env file (holds FLASK_SECRET_KEY etc.). The .example IS committed.
gate.env
!gate.env.example
# The BigQuery service-account key placed on the server.
sa.json

# --- Google / GCP service-account key files ---
# Broad safety net for credential JSON keys. .env.example is not JSON,
# so this cannot accidentally exclude it.
*service-account*.json
service_account*.json
*-credentials*.json
credentials*.json
gcp-*.json
zouk-wh-*.json
*.pem
*.key

# --- Runtime data (generated on the server) ---
channels.json
channels.json.tmp

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
